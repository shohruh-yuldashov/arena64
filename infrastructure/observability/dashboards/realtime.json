{
  "uid": "arena64-realtime",
  "title": "Arena64 \u2014 realtime and games",
  "description": "The paths a player feels immediately. Cross-instance delivery is the one that fails silently: the durable log is unaffected, so a game is recoverable and the experience is not.",
  "tags": [
    "arena64"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "WebSocket connections",
      "description": "A64-028.5A held 2000 idle sockets on one instance with zero drops, at about 100 KB of RSS each.",
      "id": 1,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(arena64_gateway_connections_accepted_total[5m]))",
          "legendFormat": "accepted/s",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (reason) (rate(arena64_gateway_connections_closed_total[5m]))",
          "legendFormat": "closed {{reason}}",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (reason) (rate(arena64_gateway_connections_rejected_total[5m]))",
          "legendFormat": "rejected {{reason}}",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cross-instance delivery",
      "description": "P1-9's symptom. A refused publish never reaches the opponent and neither player is told.",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(arena64_gateway_remote_publishes_total[5m]))",
          "legendFormat": "published/s",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(arena64_gateway_remote_publish_failures_total[5m]))",
          "legendFormat": "refused/s",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(arena64_gateway_forwarded_frames_total[5m]))",
          "legendFormat": "forwarded/s",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(arena64_gateway_forwarding_failures_total[5m]))",
          "legendFormat": "forward failures/s",
          "refId": "D"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Moves",
      "description": "Rejection categories are a closed enum; rate_limited among them is the only place an HTTP-style refusal was visible before this task.",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(arena64_gateway_moves_accepted_total[5m]))",
          "legendFormat": "accepted/s",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (category) (rate(arena64_gateway_moves_rejected_total[5m]))",
          "legendFormat": "rejected {{category}}",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Matchmaking",
      "description": "The scan runs every second per pool, which is what makes its silence an unambiguous scheduler-liveness signal.",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (outcome) (rate(arena64_matchmaking_pairing_scans_total[5m]))",
          "legendFormat": "scan {{outcome}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(arena64_matchmaking_pairing_candidates_total[5m]))",
          "legendFormat": "candidates/s",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Game resumes",
      "description": "A deploy produces a burst here: every client reconnects and resyncs from the durable log. A64-028.6 measured 265 ms to reconnect and resume.",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (outcome) (rate(arena64_gateway_resumes_total[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Rooms",
      "description": "",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(arena64_gateway_room_joins_total[5m]))",
          "legendFormat": "joins/s",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (reason) (rate(arena64_gateway_room_leaves_total[5m]))",
          "legendFormat": "leaves {{reason}}",
          "refId": "B"
        }
      ]
    }
  ]
}
