# Copy to .env.local for local development. Never commit a real .env file —
# see docs/03-backend/dependency-injection.md §2.4 and CLAUDE.md §5 rule 6.
#
# Layering (dependency-injection.md §2.2): code defaults < this file (local
# only) < process environment variables (deployed tiers) < secret manager
# (secrets only). Nothing in this file is a secret.

# Three environments this file's values distinguish, matching
# app/config/environment.py's `Environment` enum:
#   local        — this file. A developer's own machine, docker-compose
#                  infrastructure (docker/docker-compose.yml), human-
#                  readable logs, permissive validation.
#   test          — no file is read at all (tests/conftest.py sets what
#                  little configuration it needs directly); see
#                  CONTRACT_TEST_POSTGRES_DSN below for the one exception.
#   production    — real environment variables from the deploy platform,
#                  real secrets from the secret manager. Settings.py
#                  refuses to start if any value below is still the
#                  code-level local default (dependency-injection.md DI-06).
ENVIRONMENT=local

# --- app -----------------------------------------------------------------
APP_NAME=arena64-api
APP_LOG_LEVEL=DEBUG
APP_LOG_FORMAT=human

# --- postgres --------------------------------------------------------------
# One primary DSN. Read-replica routing is deferred — see database.md §13.2
# and this task's recommendations.
#
# Matches docker/docker-compose.yml's default host port (5432). If you
# started that stack with POSTGRES_PORT set (e.g. because something else
# on your machine already listens on 5432), change the port here to match.
POSTGRES_DSN=postgresql+asyncpg://arena64:arena64@localhost:5432/arena64
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=5
POSTGRES_POOL_TIMEOUT_SECONDS=30
POSTGRES_STATEMENT_TIMEOUT_MS=5000
POSTGRES_ECHO=false

# --- redis — five role-separated instances (architecture.md AD-03) ---------
# In `local`, all five may point at the same instance with different DB
# indices; in `production` each is its own instance, sized and persistence-
# configured for its own workload (architecture.md §4 AD-03). Matches
# docker/docker-compose.yml's default host port (6379) — see the note
# on POSTGRES_DSN above if you started that stack with REDIS_PORT set.
REDIS_LIVE_URL=redis://localhost:6379/0
REDIS_BUS_URL=redis://localhost:6379/1
REDIS_BROKER_URL=redis://localhost:6379/2
REDIS_CACHE_URL=redis://localhost:6379/3
# Rate limit counters (A64-011.8). The fifth role, and the one that must be
# configured with **no eviction policy** in a deployed tier: a counter
# evicted under memory pressure is a limit that disappears during exactly
# the traffic spike it exists for. Never point this at the `cache`
# instance, which is configured to evict by design.
REDIS_LIMITS_URL=redis://localhost:6379/4

# --- rate_limit — abuse prevention (A64-011.8) ------------------------------
# Every limit is configurable so an incident is answered by a restart rather
# than a release. Only the two settings without a safe default are shown;
# the per-endpoint limits are documented on `RateLimitSettings` and are left
# at the figures A64-011.8 specifies unless there is a reason to move them.
#
# RATE_LIMIT_TRUSTED_PROXY_COUNT is the one that **must** be set in any tier
# behind a load balancer, and both wrong values are severe:
#   0 behind a proxy  -> every request appears to come from the balancer, so
#                        the whole platform shares one per-IP bucket
#   non-zero with no proxy -> X-Forwarded-For is believed, and any client can
#                        set its own rate-limit identity
RATE_LIMIT_TRUSTED_PROXY_COUNT=0
# `true` (default): a Redis outage degrades abuse prevention rather than
# removing the ability to sign in. `false` returns 503 instead — choose it
# only where credential stuffing outranks availability.
RATE_LIMIT_FAIL_OPEN=true

# --- tests/contract/ — not read by the application itself -------------------
# tests/contract/conftest.py reads this one variable directly (not through
# app.config.settings — `test` reads no file at all, by design). Points at
# a *separate* database from POSTGRES_DSN above, created automatically by
# docker/postgres/init/01-create-test-database.sql on a fresh
# docker-compose volume, so a test that bypasses the suite's transaction-
# rollback fixture can never corrupt real local dev data.
# CONTRACT_TEST_POSTGRES_DSN=postgresql+asyncpg://arena64:arena64@localhost:5432/arena64_test
#
# The rate-limiting contract suites need a real Redis and **flush the
# database they are given**. Database 15, never 0-4, which is what the five
# roles above point at in `local` — flushing a developer's live match state
# because a test picked the same index only has to happen once.
# CONTRACT_TEST_REDIS_URL=redis://localhost:6379/15
