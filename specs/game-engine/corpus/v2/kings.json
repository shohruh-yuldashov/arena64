{
  "corpus_version": 2,
  "scope": "King movement — quiet slides, captures begun by a king, multiple landing squares beyond one victim, direction changes mid-sequence, and promotion continuation under all three configured variant rules (A64-014.5). Every case is a complete legal move set.",
  "supersedes": [
    {
      "version": 1,
      "id": "a-king-of-the-side-to-move-cannot-be-evaluated",
      "replaced_by": "king-quiet-moves-along-open-diagonals",
      "reason": "A64-014.3 refused any position holding a king of the side to move, because kings had no moves to generate and an incomplete move set presented as complete would have told terminal-state detection that the player had lost. A64-014.5 implements king movement, so the refusal is gone and the exception with it. The replacement case uses the identical position — one light king on c3, light to move — and asserts the eleven moves it now has."
    }
  ],
