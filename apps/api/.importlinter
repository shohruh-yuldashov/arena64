    app.modules.rating.infrastructure
allow_indirect_imports = True

# `rating` reaches other contexts only through their published surfaces, like
# every context before it. It needs exactly one thing from outside: the
# variant a rating is keyed by.
[importlinter:contract:rating-reaches-modules-through-public]
name = rating reaches every module only through its published surface
type = forbidden
source_modules =
    app.modules.rating
forbidden_modules =
    app.modules.auth.domain
    app.modules.auth.application
    app.modules.auth.infrastructure
    app.modules.avatars
    app.modules.engine
    app.modules.friends.domain
    app.modules.friends.application
    app.modules.friends.infrastructure
    app.modules.game.domain
    app.modules.game.application
    app.modules.game.infrastructure
    app.modules.matchmaking
    app.modules.notifications
    app.modules.profiles
    app.modules.statistics
    app.modules.users.domain
    app.modules.users.application
    app.modules.users.infrastructure
allow_indirect_imports = True

[importlinter:contract:layers-rating]
name = rating layers point inward
type = layers
layers =
    app.modules.rating.presentation
    app.modules.rating.infrastructure
    app.modules.rating.application
    app.modules.rating.domain

# ---------------------------------------------------------------------------
# `reference` — A64-020.5A-pre
# ---------------------------------------------------------------------------
# The platform's shared catalogue (DB-08), and the newest context. Two
# contracts, the same pair every other module has, and they carry more weight
# here than usual because *everybody* will eventually want to read reference
# data — which is exactly how a `reference.infrastructure` import ends up in
# four modules and the catalogue becomes an ORM model with a public API.
#
# `matchmaking.presentation.dependencies` is outside the source list for the
# reason every composition root is: constructing another module's concrete
# class is what a root is for. It is the only place
# `SqlAlchemyTimeControlCatalogue` is named.
[importlinter:contract:reference-internals-are-private]
name = reference internals are reachable only through reference.public
type = forbidden
source_modules =
    app.gateway
    app.modules.auth
    app.modules.avatars
    app.modules.friends
    app.modules.game
    app.modules.matchmaking.domain
    app.modules.matchmaking.application
    app.modules.matchmaking.infrastructure
    app.modules.matchmaking.presentation.router
    app.modules.matchmaking.presentation.schemas
    app.modules.notifications
    app.modules.profiles
    app.modules.rating
    app.modules.statistics
    app.modules.tournament
    app.modules.users
forbidden_modules =
    app.modules.reference.domain
    app.modules.reference.infrastructure
allow_indirect_imports = True

# `reference` reaches other contexts only through their published surfaces. It
# needs exactly one thing from outside — `rating.public.SpeedClass`, the key
# component a time control classifies into — and `reference.public` records
# why that arrow points the way it does rather than the way database.md §6.2
# draws it.
#
# The rule that matters most is the one about `game` and `matchmaking`:
# reference data must never learn what a *match* or a *queue* is, or the
# catalogue stops being data and starts being a service.
#
# `auth` is narrowed to its three internal layers rather than forbidden
# outright, exactly as `rating`'s equivalent contract narrows it and for the
# same reason: `auth.presentation.dependencies.CurrentUser` is the
# platform-wide way a router names its caller, and every module's router on
# this platform imports it. Forbidding it would mean either an unauthenticated
# endpoint or a second identity dependency.
[importlinter:contract:reference-reaches-modules-through-public]
name = reference reaches every module only through its published surface
type = forbidden
source_modules =
    app.modules.reference
forbidden_modules =
    app.modules.auth.domain
    app.modules.auth.application
    app.modules.auth.infrastructure
    app.modules.avatars
    app.modules.engine
    app.modules.friends
    app.modules.game
    app.modules.matchmaking
    app.modules.notifications
    app.modules.profiles
    app.modules.rating.domain
    app.modules.rating.application
    app.modules.rating.infrastructure
    app.modules.statistics
    app.modules.tournament
    app.modules.users
allow_indirect_imports = True

[importlinter:contract:statistics-internals-are-private]
name = statistics internals are reachable only through statistics.public
type = forbidden
source_modules =
    app.modules.game.domain
    app.modules.auth
    app.modules.avatars
    app.modules.friends.domain
    app.modules.friends.application
    app.modules.friends.infrastructure
    app.modules.matchmaking.domain
    app.modules.matchmaking.application
    app.modules.matchmaking.infrastructure
    app.modules.notifications
    app.modules.profiles.domain
    app.modules.profiles.application
    app.modules.profiles.infrastructure
    app.modules.users
forbidden_modules =
    app.modules.statistics.domain
    app.modules.statistics.application
    app.modules.statistics.infrastructure
allow_indirect_imports = True

# A64-014.1 required this contract to exist "from the first commit", and
# there is a real difference between adding one now and adding one later:
# the four above were written after their modules had consumers, so each had
# to be checked against imports that already existed. This one is written
# before `matchmaking` has any, which means the first import that would
# violate it fails on the pull request that introduces it rather than being
# discovered in an audit.
[importlinter:contract:matchmaking-internals-are-private]
name = matchmaking internals are reachable only through matchmaking.public
type = forbidden
source_modules =
    app.modules.auth
    app.modules.avatars
    app.modules.friends
    app.modules.notifications
    app.modules.profiles
    app.modules.statistics
    app.modules.users
forbidden_modules =
    app.modules.matchmaking.domain
    app.modules.matchmaking.application
    app.modules.matchmaking.infrastructure
allow_indirect_imports = True

# ---------------------------------------------------------------------------
# 2b. No cycles through matchmaking — A64-014.1
# ---------------------------------------------------------------------------
# R-6 forbids cyclic dependencies "including through events", and
# import-linter has no general cycle detector: a `layers` contract orders
# layers, and an `independence` contract between every pair of modules would
# forbid the composition roots that already wire them together.
#
# What *can* be checked is the strongest available statement about the new
# module, and it happens to be exactly the one that makes a cycle through it
# unconstructible: nothing outside `matchmaking` may import any part of it,
# including its `public/` package.
#
# That is stricter than the contract above and it is deliberate. Combined
# with `matchmaking-internals-are-private`, the module's whole import
# surface is one-directional — matchmaking may depend on `users.public` and
# on `app.platform`, and no module may depend on matchmaking at all — so
# there is no pair of edges a cycle could be built from.
#
# **This contract is expected to be relaxed, not deleted.** The first real
# consumer (architecture.md §7 draws `matchmaking -> game`, so `game` is the
# likelier direction) removes itself from the source list and adds a port to
# `matchmaking.public`. The relaxation is then a visible, argued diff rather
# than an import somebody happened to write.
#
# **A64-022.4 is that diff, and the consumer is `notifications`.** It reads
# `matchmaking.public`'s two friend-challenge lifecycle events so a recipient
# can be told they have been invited and a challenger can be told their game
# exists. It is absent from the source list below and **still present** in
# `matchmaking-internals-are-private` above, so the relaxation is exactly one
# package wide: `notifications` may name `matchmaking.public` and nothing
# else under `matchmaking`.
#
# No cycle becomes constructible. What crosses is a published event class —
# a fact, not a capability — and `matchmaking` imports no part of
# `notifications`, so the edge is one-directional.
[importlinter:contract:matchmaking-is-not-a-dependency]
name = no module depends on matchmaking
type = forbidden
source_modules =
    app.modules.auth
    app.modules.avatars
    app.modules.friends
    app.modules.profiles
    app.modules.statistics
    app.modules.users
forbidden_modules =
    app.modules.matchmaking
# **Direct imports only**, matching `matchmaking-internals-are-private` above
# and for the reason that contract has always needed it: once one module is
# allowed to name `matchmaking.public`, every module that reaches *it* gains
# an indirect edge. `auth`'s router imports `notifications`' dependency
# module, which builds the challenge consumer — a chain that says nothing
# about whether `auth` depends on matchmaking, and everything about how a
# composition root is assembled.
#
# What the contract still enforces is the statement worth keeping: none of
# the modules below may write `import app.modules.matchmaking` itself.
allow_indirect_imports = True


# ---------------------------------------------------------------------------
# 3. Dependencies point inward — CLAUDE.md §3.1, architecture.md §8
# ---------------------------------------------------------------------------
# "transport -> service -> domain, and a layer never imports from the layer
# above it." One `layers` contract per module, each read top-to-bottom as
# high-level-to-low-level.
#
# `infrastructure` sits **beside** `application` rather than above or below it,
# and import-linter expresses that with a colon-separated "independent siblings
# at one level" — an adapter implements an application port (so it imports
# `application`) while an application service must never import an adapter.
# Listing them as siblings would forbid the first; listing infrastructure above
# application permits it and forbids the reverse, which is the actual rule.

[importlinter:contract:layers-users]
name = users layers point inward
type = layers
layers =
    app.modules.users.presentation
    app.modules.users.infrastructure
    app.modules.users.application
    app.modules.users.domain

[importlinter:contract:layers-auth]
name = auth layers point inward
type = layers
layers =
    app.modules.auth.presentation
    app.modules.auth.infrastructure
    app.modules.auth.application
    app.modules.auth.domain

[importlinter:contract:layers-friends]
name = friends layers point inward
type = layers
layers =
    app.modules.friends.presentation
    app.modules.friends.infrastructure
    app.modules.friends.application
    app.modules.friends.domain

[importlinter:contract:layers-profiles]
name = profiles layers point inward
type = layers
layers =
    app.modules.profiles.presentation
    app.modules.profiles.infrastructure
    app.modules.profiles.application
    app.modules.profiles.domain

[importlinter:contract:layers-matchmaking]
name = matchmaking layers point inward
type = layers
layers =
    app.modules.matchmaking.presentation
    app.modules.matchmaking.infrastructure
    app.modules.matchmaking.application
    app.modules.matchmaking.domain

[importlinter:contract:layers-notifications]
name = notifications layers point inward
type = layers
layers =
    app.modules.notifications.presentation
    app.modules.notifications.infrastructure
    app.modules.notifications.application
    app.modules.notifications.domain

[importlinter:contract:layers-avatars]
name = avatars layers point inward
type = layers
layers =
    app.modules.avatars.presentation
    app.modules.avatars.infrastructure
    app.modules.avatars.application
    app.modules.avatars.domain

# `statistics` has no `presentation` layer and needs none: it is consumed
# entirely through `statistics.public` by `profiles`, and has no endpoint of
# its own. Listing a layer that does not exist is an error rather than a
# no-op, so the contract names the three that do.
[importlinter:contract:layers-statistics]
name = statistics layers point inward
type = layers
layers =
    app.modules.statistics.infrastructure
    app.modules.statistics.application
    app.modules.statistics.domain

# `game` gained `application` and `infrastructure` in A64-015.4 — match
# persistence is what earned them, and A64-014.6 had recorded their absence
# in the module docstring. It has no `presentation` layer and needs none:
# every endpoint that touches a match today is a *matchmaking* endpoint,
# because a player who has not accepted yet is still being matched. Listing
# a layer that does not exist is an error rather than a no-op, so this names
# the three that do.
#
# `public` is deliberately outside the ordering. It is a published surface
# rather than a layer — `game.domain.match_record` reads `ProductVariant`
# from `public.variants`, and `public.acceptance` re-exports
# `MatchRecordStatus` from the domain — and a `layers` contract would have
# to forbid one direction or the other.
[importlinter:contract:layers-game]
name = game layers point inward
type = layers
layers =
    app.modules.game.infrastructure
    app.modules.game.application
    app.modules.game.domain


# ---------------------------------------------------------------------------
# 4. The rules kernel is dependency-free — architecture.md §11, AD-13
# ---------------------------------------------------------------------------
# "The `engine` module is a **pure rules kernel**: no I/O, no clock, no
# randomness, no logging, no framework, no database, no configuration."
#
# That sentence is the entire reason the engine can be trusted with a
# competitive result. AD-13 spells out why in three parts, and each one dies
# to a different import: exhaustive testing (perft counts, apply/undo
# property tests, differential testing against the TypeScript engine) needs
# purity; mirroring the same rules in the client needs a fixed, ambient-free
# contract; and moving `fairplay`'s CPU-bound replay to a worker needs a
# kernel with nothing to carry.
#
# The failure this catches is not malice, it is a reporting requirement:
# somebody adds a database lookup to a rules function because a query was
# easier there than at the caller, the engine keeps passing its tests, and
# the guarantee is gone with nothing red.
#
# The two contracts below are the strongest form of that rule the import
# graph can express — what the kernel may import, and who may import it.
#
# `app.core` is deliberately absent from the forbidden list: it is the shared
# kernel the layer table in architecture.md §8 permits every `domain/` to
# use, and the engine's failures inherit from `app.core.exceptions` so they
# render through the platform's one error taxonomy rather than a parallel
# tree.
#
# `engine` is also absent from `domain-is-framework-free` below, and is not
# an omission: the frameworks that contract names are a subset of what this
# one forbids, and listing it twice would let a future edit weaken one while
# the other looked like it was still covering it.
[importlinter:contract:engine-is-a-dependency-free-kernel]
name = engine imports nothing but the shared kernel
type = forbidden
source_modules =
    app.modules.engine
forbidden_modules =
    app.modules.auth
    app.modules.avatars
    app.modules.friends
    app.modules.game
    app.modules.notifications
    app.modules.profiles
    app.modules.statistics
    app.modules.users
    app.platform
    app.api
    app.common
    app.config
    app.database
    app.repositories
    app.storage
    sqlalchemy
    fastapi
    starlette
    redis
    logging
    random
    datetime

# ---------------------------------------------------------------------------
# 5. Only `game`, `replay` and `fairplay` may import the engine — R-2
# ---------------------------------------------------------------------------
# "The other two replay finished games; they never write... The two read-only
# exceptions are the whole reason the engine is a peer module rather than a
# private package inside `game`."
#
# `game` exists as of A64-014.6 and is one of the three, so it is absent from
# the source list below — that absence is the permission. `replay` and
# `fairplay` do not exist yet.
#
# Each new module joins this list unless it is one of those three, which is the
# point: a module that wants the rules of checkers has to argue for it in a
# diff, and the argument is architecture.md §7's import diagram, where "any
# edge not drawn is forbidden".
# ## `allow_indirect_imports`, added by A64-015.2
#
# The same reason the four privacy contracts above carry it, and the same
# argument: `game.public` names engine types — `ProductVariant`'s values are
# `BoardVariant`'s, `game_engine_version()` returns an `EngineVersion` — so
# `matchmaking -> game.public -> engine` is a chain R-1 *requires*, and a
# contract counting indirect imports would flag every correct consumer of the
# published surface.
#
# What stays forbidden is the **direct** import: a queue service naming
# `MoveGenerator` itself. That is the reachable-by-typing mistake, it is the
# one the graph can see, and a probe confirms it still fails the build.
[importlinter:contract:engine-has-three-permitted-consumers]
name = only game, replay and fairplay may import engine
type = forbidden
source_modules =
    app.modules.auth
    app.modules.avatars
    app.modules.friends
    app.modules.matchmaking
    app.modules.notifications
    app.modules.profiles
    app.modules.statistics
    app.modules.users
forbidden_modules =
    app.modules.engine
allow_indirect_imports = True


[importlinter:contract:game-internals-are-private]
name = game internals are reachable only through game.public
type = forbidden
source_modules =
    app.modules.auth
    app.modules.avatars
    app.modules.friends
    app.modules.matchmaking.domain
    app.modules.matchmaking.application
    app.modules.matchmaking.infrastructure
    app.modules.matchmaking.presentation.router
    app.modules.matchmaking.presentation.schemas
    app.modules.notifications
    app.modules.profiles
    app.modules.statistics
    app.modules.users
forbidden_modules =
    app.modules.game.domain
    app.modules.game.application
    app.modules.game.infrastructure
allow_indirect_imports = True


# ---------------------------------------------------------------------------
# 5b. `matchmaking` reaches `game` only through its published surface — A64-015.2
# ---------------------------------------------------------------------------
# The first cross-module edge into `game`, and architecture.md §7 draws it:
# `MM -->|"creates match"| GAME`. What the diagram does not say, and R-1 does,
# is that the edge lands on a *published surface* rather than on an aggregate.
#
# So `matchmaking` is added to `game-internals-are-private` above rather than
# given a contract of its own, and its `presentation/dependencies` — the
# composition root — is deliberately outside the source list for the same
# reason every other module's is: assembling another module's concrete classes
# is what a root is for.
#
# The intended edge, and the only one:
#
#     matchmaking -> game.public
#
# `matchmaking` is also added to `engine-has-three-permitted-consumers` above.
# It was absent before this task — not by decision but because it did not
# exist when that list was written — which meant nothing stopped a queue
# service importing `MoveGenerator` directly. R-2 permits exactly `game`,
# `replay` and `fairplay`; matchmaking reaches the rules through `game.public`
# or not at all.
#
# The two contracts together are what make `game.public` load-bearing rather
# than advisory: an import of `game.domain` fails the build, and an import of
# `engine` fails it too, so the published surface is the only door.

# ---------------------------------------------------------------------------
# 5c. `matchmaking` reaches `friends` only through its published surface —
#     A64-015.3
# ---------------------------------------------------------------------------
# The pairing scan is where BL-2 is finally enforced — a blocked pair is
# unpairable — and it needs a batch, all-pairs read that no existing consumer
# of `friends` wanted. That read is published as
# `friends.public.PairingExclusions`, a third port beside `SocialGraphReader`
# and `PresenceAudience`, split by *question* exactly as those two were.
#
# **No new contract was needed**, and that is the useful fact rather than an
# omission: `friends-internals-are-private` above already names
# `app.modules.matchmaking.domain`, `.application` and `.infrastructure` as
# sources, because A64-013.5 wrote the list to cover every module that existed
# rather than every module that then had an edge. The first real
# `matchmaking -> friends` import therefore arrived with the fence already
# built, and a probe confirms it: an import of `friends.domain.block` from
# `pairing_service.py` breaks the contract.
#
# `presentation/dependencies` stays outside the source list, as it does for
# every other privacy contract — it names `SqlAlchemyBlockedPlayerRepository`
# and `PairingExclusionService` directly, which is what a composition root is
# for.
#
# The intended edges, and the only ones:
#
#     matchmaking -> game.public
#     matchmaking -> friends.public
#     matchmaking -> users.public


# ---------------------------------------------------------------------------
# 6. The domain is framework-free — architecture.md §8
# ---------------------------------------------------------------------------
# "Business rules must not import HTTP, ORM, or UI framework types. If the
# framework changed tomorrow, the domain should not."
#
# The one that would be violated silently is SQLAlchemy: an aggregate that
# imported a `Mapped` type would still pass every test, and the coupling would
# only be discovered by whoever tried to unit-test it without a database.
#
# This is the contract that forces `include_external_packages = True` in the
# header: import-linter only builds edges to third-party packages when asked,
# and a contract naming `sqlalchemy` would otherwise pass by finding no edges
# at all — the worst kind of green.
#
# ## Why `app.platform.tasks` is a source here — A64-014.1
#
# It joins `app.platform.events` rather than the module domains' list, and
# for the same reason that one is here: it is the *contract* half of AD-17's
# seam. A `TaskRequest` must be constructible in a unit test with no
# framework and encodable by a broker that knows none, so the moment it
# could hold a SQLAlchemy object the Celery migration would be blocked by a
# payload nobody can serialise — and the failure would surface on the day of
# the migration rather than on the pull request that caused it.
#
# The handlers are deliberately *not* covered: `OutboxRetentionTask` and
# `QueueExpiryTask` hold session factories and belong to the layers that may.
# ---------------------------------------------------------------------------
# The gateway is a transport tier, not a context — R-7, AD-09
# ---------------------------------------------------------------------------
# architecture.md R-7: "The gateway contains no domain logic. It validates,
# authenticates, rate-limits, routes, and fans out. It never decides whether a
# move is legal."
#
# That rule is worth exactly nothing as prose, because the way it breaks is
# gradual and each step looks reasonable: a route needs one type from `game`,
# then a helper needs a repository, and eventually the tier that "contains no
# domain logic" is where a move is validated because that is where the socket
# is. This contract makes the first step fail instead.
#
# `app.gateway` therefore reaches every module the same way `app/api/` does —
# through `public/` for capabilities and through `presentation/dependencies`
# for composition. Concretely it holds three things: `users.public`'s
# `PresenceRecorder`, `auth.presentation.dependencies`' ticket service (because
# `auth.public` deliberately publishes nothing that can mint or inspect a
# credential, and says so), and its own Redis registry.
#
# The gateway is deliberately **not** `app.platform` either: that package must
# import no bounded context at all, and this tier's entire job is to call two.
#
# `allow_indirect_imports` for the reason every privacy contract above sets it:
# a `public/` package re-exports its own module's domain types, so
# `gateway -> users.public -> users.domain` is a chain the rules require.
[importlinter:contract:gateway-reaches-modules-through-public]
name = the gateway reaches every module only through its published surface
type = forbidden
source_modules =
    app.gateway
forbidden_modules =
    app.modules.auth.domain
    app.modules.auth.application
    app.modules.auth.infrastructure
    app.modules.avatars.domain
    app.modules.avatars.application
    app.modules.avatars.infrastructure
    app.modules.engine
    app.modules.friends.domain
    app.modules.friends.application
    app.modules.friends.infrastructure
    app.modules.game.domain
    app.modules.game.application
    app.modules.game.infrastructure
    app.modules.matchmaking.domain
    app.modules.matchmaking.application
    app.modules.matchmaking.infrastructure
    app.modules.notifications.domain
    app.modules.notifications.application
    app.modules.notifications.infrastructure
    app.modules.profiles.domain
    app.modules.profiles.application
    app.modules.profiles.infrastructure
    app.modules.statistics
    app.modules.users.domain
    app.modules.users.application
    app.modules.users.infrastructure
allow_indirect_imports = True


[importlinter:contract:domain-is-framework-free]
name = domain layers import no framework
type = forbidden
source_modules =
    app.modules.auth.domain
    app.modules.avatars.domain
    app.modules.friends.domain
    app.modules.game.domain
    app.modules.matchmaking.domain
    app.modules.notifications.domain
    app.modules.profiles.domain
    app.modules.reference.domain
    app.modules.statistics.domain
    app.modules.users.domain
    app.platform.events
