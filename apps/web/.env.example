# Copy to .env.local for local development. Never commit a real .env file.
# See src/lib/env.ts — every variable below is validated at startup; a
# missing or malformed value fails the build loudly instead of shipping a
# client that silently calls the wrong API.

# Base URL of apps/api's HTTP entrypoint (architecture.md AD-02). No
# trailing slash — src/services/api-client.ts joins paths onto this as-is.
NEXT_PUBLIC_API_URL=http://localhost:8000
