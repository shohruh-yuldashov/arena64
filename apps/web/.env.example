# Arena64 web client — copy to `.env.local` and adjust.
#
# Every variable is read once, at boot, by `src/shared/config/env.ts` and
# validated there. A missing or malformed value fails loudly at startup
# rather than surfacing as a broken request three layers away.
#
# Only `VITE_`-prefixed variables reach the browser bundle. There is no
# such thing as a frontend secret: anything listed here is public by
# construction, so never put a credential in this file or in `.env.local`.

# Base URL of the Arena64 API, without a trailing slash.
VITE_API_URL=http://localhost:8000
