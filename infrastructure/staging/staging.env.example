# Staging configuration — copy to `staging.env` and fill in.
#
# `staging.env` is gitignored and must stay that way. Every value below is a
# secret or an environment fact; none of them belongs in this repository.
#
#     cp staging.env.example staging.env
#     docker compose --env-file staging.env up -d
#
# Generate the two application secrets with:
#
#     openssl rand -hex 32

# --- what this tier is --------------------------------------------------
# The hostname Caddy obtains a certificate for and the application builds
# every email link from. It must already resolve to this host: Caddy's ACME
# challenge fails otherwise, and the failure is a certificate that never
# appears rather than an error anybody sees.
ARENA64_DOMAIN=staging.example.com

# The image tag to run. `latest` follows whatever was last built; a release
# pins a digest. Set explicitly when reproducing a report.
ARENA64_TAG=latest

# --- secrets ------------------------------------------------------------
# At least 64 characters. `Settings` refuses to start a deployed tier on the
# development key, because a service running on the key that is in the
# source can have a token minted for any account by anybody holding the
# repository.
JWT_SECRET_KEY=

# Signs the email-verification codes. Same rule, same reason.
EMAIL_VERIFICATION_OTP_SECRET=

POSTGRES_PASSWORD=

# MinIO's root credentials, which are also the S3 credentials the
# application signs with. A dedicated access key scoped to the one bucket
# would be better and is what a production tier should have; for a first
# staging environment on one host, the root pair is one fewer moving part.
MINIO_ROOT_USER=arena64
MINIO_ROOT_PASSWORD=

# --- email --------------------------------------------------------------
# Optional. Without it the platform records that a message could not be
# sent rather than pretending it was — verification links then have to be
# read out of the logs, which is acceptable on staging and is why this is
# not required to boot.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@example.com
