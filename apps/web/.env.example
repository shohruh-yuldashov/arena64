# Arena64 web client — copy to `.env.local` and adjust.
#
# Every variable is read once, at boot, by `src/shared/config/env.ts` and
# validated there. A missing or malformed value fails loudly at startup
# rather than surfacing as a broken request three layers away.
#
# Only `VITE_`-prefixed variables reach the browser bundle. There is no
# such thing as a frontend secret: anything listed here is public by
# construction, so never put a credential in this file or in `.env.local`.

# Where the API is, from the browser. Leave it unset in normal development:
# the default is the relative path `/api/v1`, and the Vite dev server
# proxies `/api` to FastAPI so the page and the API share one origin.
#
# That shared origin is a requirement, not a convenience — the refresh
# token lives in an HttpOnly, same-site cookie, and a cross-origin API
# would either not receive it or would need SameSite=None, which is the
# CSRF exposure the cookie exists to avoid.
#
# In production a reverse proxy must route /api to FastAPI. See
# specs/frontend.md §12.
# VITE_API_URL=/api/v1

# Where the dev-server proxy forwards /api. Not a VITE_ variable: it is
# read by vite.config.ts at build time and never reaches the browser.
# ARENA64_API_TARGET=http://localhost:8000
