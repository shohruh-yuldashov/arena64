# Copy to .env.local for local development. Never commit a real .env file —
# see docs/03-backend/dependency-injection.md §2.4 and CLAUDE.md §5 rule 6.
#
# Layering (dependency-injection.md §2.2): code defaults < this file (local
# only) < process environment variables (deployed tiers) < secret manager
# (secrets only). Nothing in this file is a secret.

# Three environments this file's values distinguish, matching
# app/config/environment.py's `Environment` enum:
#   local        — this file. A developer's own machine, docker-compose
#                  infrastructure (docker/docker-compose.yml), human-
#                  readable logs, permissive validation.
#   test          — no file is read at all (tests/conftest.py sets what
#                  little configuration it needs directly); see
#                  CONTRACT_TEST_POSTGRES_DSN below for the one exception.
#   production    — real environment variables from the deploy platform,
#                  real secrets from the secret manager. Settings.py
#                  refuses to start if any value below is still the
#                  code-level local default (dependency-injection.md DI-06).
ENVIRONMENT=local

# --- app -----------------------------------------------------------------
APP_NAME=arena64-api
APP_LOG_LEVEL=DEBUG
APP_LOG_FORMAT=human

# --- postgres --------------------------------------------------------------
# One primary DSN. Read-replica routing is deferred — see database.md §13.2
# and this task's recommendations.
#
# Matches docker/docker-compose.yml's default host port (5432). If you
# started that stack with POSTGRES_PORT set (e.g. because something else
# on your machine already listens on 5432), change the port here to match.
POSTGRES_DSN=postgresql+asyncpg://arena64:arena64@localhost:5432/arena64
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=5
POSTGRES_POOL_TIMEOUT_SECONDS=30
POSTGRES_STATEMENT_TIMEOUT_MS=5000
POSTGRES_ECHO=false

# --- redis — five role-separated instances (architecture.md AD-03) ---------
# In `local`, all five may point at the same instance with different DB
# indices; in `production` each is its own instance, sized and persistence-
# configured for its own workload (architecture.md §4 AD-03). Matches
# docker/docker-compose.yml's default host port (6379) — see the note
# on POSTGRES_DSN above if you started that stack with REDIS_PORT set.
REDIS_LIVE_URL=redis://localhost:6379/0
REDIS_BUS_URL=redis://localhost:6379/1
REDIS_BROKER_URL=redis://localhost:6379/2
REDIS_CACHE_URL=redis://localhost:6379/3
# Rate limit counters (A64-011.8). The fifth role, and the one that must be
# configured with **no eviction policy** in a deployed tier: a counter
# evicted under memory pressure is a limit that disappears during exactly
# the traffic spike it exists for. Never point this at the `cache`
# instance, which is configured to evict by design.
REDIS_LIMITS_URL=redis://localhost:6379/4

# --- rate_limit — abuse prevention (A64-011.8) ------------------------------
# Every limit is configurable so an incident is answered by a restart rather
# than a release. Only the two settings without a safe default are shown;
# the per-endpoint limits are documented on `RateLimitSettings` and are left
# at the figures A64-011.8 specifies unless there is a reason to move them.
#
# RATE_LIMIT_TRUSTED_PROXY_COUNT is the one that **must** be set in any tier
# behind a load balancer, and both wrong values are severe:
#   0 behind a proxy  -> every request appears to come from the balancer, so
#                        the whole platform shares one per-IP bucket
#   non-zero with no proxy -> X-Forwarded-For is believed, and any client can
#                        set its own rate-limit identity
RATE_LIMIT_TRUSTED_PROXY_COUNT=0
# `true` (default): a Redis outage degrades abuse prevention rather than
# removing the ability to sign in. `false` returns 503 instead — choose it
# only where credential stuffing outranks availability.
RATE_LIMIT_FAIL_OPEN=true

# --- search (A64-013.1) -----------------------------------------------------
# `GET /users/search` is rate limited **per authenticated user**, not per
# address: its abuse is enumeration — building a list of who is on the
# platform a page at a time — and a per-IP budget is defeated by a botnet
# while punishing a shared campus connection. Counting the account means an
# enumerator needs as many accounts as they want multiples of the budget,
# and registration is itself limited to 3/hour per address.
#
# The window is short on purpose. A minute-long window refuses a burst
# quickly and forgives it quickly, which is right for an interactive read;
# an hour-long window at the same rate would lock a legitimate user out for
# fifty-nine minutes over one stuck key.
RATE_LIMIT_SEARCH_USER_LIMIT=30
RATE_LIMIT_SEARCH_WINDOW_SECONDS=60

# --- presence — who is online right now (A64-012.7) -------------------------
# Uses the `cache` Redis role above — never `live` (a reconnect storm must
# not compete with in-flight match state) and never `limits` (configured to
# evict nothing).
#
# Since A64-013.6 presence has a producer: `POST /auth/login` and
# `POST /auth/refresh` mark a player online, `POST /auth/logout-all` marks
# them offline. `POST /auth/logout` deliberately does not — presence is per
# player, and one device signing out is not the player leaving.
#
# PRESENCE_TTL_SECONDS is a **coordination contract**, not a tuning knob:
# nothing tells the platform that a gateway node died, so a record lapsing on
# its own is the only thing that stops its players being marked online
# forever. Whatever writes presence must rewrite it well inside this window —
# roughly a third of it leaves room for two missed writes. With
# authentication as the producer, that "whatever" is the client's refresh
# interval: a client that refreshes less often than this window flickers
# offline between refreshes.
PRESENCE_TTL_SECONDS=60
# The kill switch, for a presence instance being replaced or resized. `false`
# wires `NoPresenceProvider` and every profile reports null presence — an
# honest degradation, unlike blank statistics, because null is what a profile
# already reports for a player who is offline or who has hidden it.
PRESENCE_ENABLED=true
# --- presence sweeper (A64-013.8) -------------------------------------------
# Closes the gap A64-013.7 recorded: a player who closes the tab produces no
# `offline` event, because nothing observes a key expiring. `presence:v1:roster`
# records who is due to lapse; the sweeper turns each closed window into the
# event that would otherwise never exist.
#
# Whether *this process* runs it — per-process, like OUTBOX_WORKER_ENABLED,
# and for the same deployment shape. Separate from PRESENCE_ENABLED, which
# makes the roster permanently empty and leaves the sweeper harmlessly idle.
PRESENCE_SWEEPER_ENABLED=true
# The worst-case delay on an `offline` notification for a player who closed
# the tab: their window closes, and up to one interval later the sweeper
# notices. Shorter is not free — each tick is a database session and a Redis
# round trip, and on a quiet platform almost all of them are empty.
PRESENCE_SWEEP_INTERVAL_SECONDS=15.0
# How many lapsed players one sweep may announce. The case that motivates the
# bound is a deploy: a node restarting takes every player it held offline at
# once, and one transaction must not hold thousands of outbox inserts.
PRESENCE_SWEEP_BATCH_SIZE=200

# --- friends cache — the social graph in Redis (A64-013.6) ------------------
# The `friends:v1:` namespace on the `cache` Redis role: one key holding a
# player's friend ids, one holding the players they cannot interact with.
# Both are read on every profile composition, every friend list page and
# every search, and both are *derived* — PostgreSQL is the system of record
# (AD-19), so an evicted key costs one query and never a fact.
#
# The kill switch, for a cache that is misbehaving. `false` wires
# `NoSocialGraphCache` and every social-graph read goes to PostgreSQL, which
# is exactly what the platform did before A64-013.6 — one query per read,
# not two. A legitimate degradation, not a stub.
FRIENDS_CACHE_ENABLED=true
# A **backstop for invalidation failing**, never the invalidation mechanism.
# The four triggers (friend accepted, friend removed, player blocked, player
# unblocked) are what keep these entries correct; this bounds how long a bug
# in one of them can serve a removed friend or a lifted block. Shorter would
# hide such a bug, longer would extend it.
FRIENDS_CACHE_TTL_SECONDS=300
# Down and slow are the same event to somebody waiting on a profile render,
# and only a timeout catches the second. Every cache command is bounded by
# this; exceeding it is a miss, and a miss is a query.
FRIENDS_CACHE_TIMEOUT_MS=50

# --- outbox — the transactional event log and its relay (A64-013.7) ---------
# AD-16: a domain event is written in the same transaction as the state change
# that caused it, and a relay publishes it afterwards. Unlike presence or the
# social graph cache, there is no setting here that turns correctness off.
#
# OUTBOX_ENABLED is an **emergency switch, not a feature flag**. With it off,
# state changes still commit and their consequences stop being recorded — it
# loses information rather than degrading performance, which is why every
# discarded event logs at WARNING. Do not run this way for long.
OUTBOX_ENABLED=true
# Whether *this process* runs the relay loop. Per-process on purpose: the
# intended shape is one API tier with this off and one small worker tier with
# it on, running the same image. It defaults to true because a single-node
# development environment has no second tier, and a feature that silently
# never delivers is worse than one competing for the event loop.
OUTBOX_WORKER_ENABLED=true
# How long the relay sleeps between ticks with nothing to do. system-design.md
# budgets it at "low seconds" — delay here delays every downstream effect on
# the platform — and one second costs one indexed query per second against an
# index that is empty when the relay is healthy (caching.md, database.md 12.5).
OUTBOX_POLL_INTERVAL_SECONDS=1.0
# How many entries one tick claims. Too small and a backlog drains at
# batch_size/poll_interval events per second — a ceiling somebody discovers
# during an incident. Too large and one tick holds a claim, and a handler's
# I/O, over hundreds of rows.
OUTBOX_BATCH_SIZE=50
# How many times an entry may be claimed before it stops being claimed. It then
# stays *unpublished*, so it keeps counting in the "oldest unpublished row"
# metric — an event that gave up must be visible, not tidied into a
# dead-letter table nobody watches.
OUTBOX_MAX_ATTEMPTS=5
# The first retry delay; doubles per attempt, capped by the next value.
OUTBOX_RETRY_BASE_SECONDS=5
# The backoff ceiling. Five minutes rather than an hour: every consumer today
# delivers a social notification, and one arriving an hour late is worse than
# one that never arrives — it is news about somebody who has since gone.
OUTBOX_RETRY_MAX_SECONDS=300
#
# --- outbox retention (A64-014.1) -------------------------------------------
# A64-013.7 shipped the outbox with rows retained forever. AD-17 makes this
# table the durable event log, which is why it can give up stream replay —
# but nothing in it said *forever*, and forever is not a policy. What the
# horizon costs is the ability to re-dispatch an event older than it; AD-19
# already requires every projection to be rebuildable from PostgreSQL rather
# than from the log, so nothing depends on that.
#
# Whether *this process* prunes. Per-process like OUTBOX_WORKER_ENABLED — one
# API tier off, one maintenance tier on, same image. Turning it off everywhere
# is how deletion is stopped during an investigation; the table then grows,
# loudly, which is the right direction for a switch that governs destruction.
OUTBOX_RETENTION_ENABLED=true
# How long a **published** entry is kept, measured on `occurred_at` — DB-18's
# eventual partition key, so this predicate and a future DETACH PARTITION
# select the same rows. An **unpublished** entry is never pruned at any age:
# it is still owed to somebody and must stay visible in the backlog metric.
OUTBOX_RETENTION_DAYS=14
# How long a `processed_event` ledger row is kept. Must be >= the value above,
# and the process refuses to start otherwise — dropping a ledger row while its
# entry can still be claimed lets that entry be redelivered *and* re-handled,
# which is the double effect the ledger exists to prevent.
OUTBOX_LEDGER_RETENTION_DAYS=30
# How often a prune runs. Retention is a floor, not a deadline — nothing is
# wrong if a row survives an extra hour — so the interval keeps each run small
# rather than the horizon sharp.
OUTBOX_PRUNE_INTERVAL_SECONDS=3600.0
# Rows per DELETE, and batches per run. Both bound the job: the interesting
# case is the *first* run after this ships, where a year of retained rows must
# drain over several runs rather than in one statement holding locks on the
# platform's highest-churn relation.
OUTBOX_PRUNE_BATCH_SIZE=1000
OUTBOX_PRUNE_MAX_BATCHES=20

# --- matchmaking — the queue, the pairing scan, the handshake ---------------
# A64-014.1, A64-015.3 and A64-015.4. Three groups: how long a player may wait
# before the platform stops asserting they are waiting; how a scan decides who
# plays whom; and the window between "you have been paired" and "you are
# playing".
#
# How long a ticket stays `waiting`. Ten minutes: a ticket that outlives the
# player's attention is worse than a short one, because the first thing a
# pairing worker will do with a waiting ticket is create a match — and a match
# created for somebody who left is a game the opponent sits through. Not
# coupled to PRESENCE_TTL_SECONDS: a closed tab is a presence question, this
# is an attention one, and a player watching a spinner is present throughout.
MATCHMAKING_TICKET_TTL_SECONDS=600
# Whether *this process* expires due tickets. Per-process, like the two
# switches above. With it off everywhere `expires_at` still governs what a
# player sees — a due ticket reads as absent — but the transition, the event
# and the log line stop happening.
MATCHMAKING_EXPIRY_ENABLED=true
# The worst-case delay between a ticket falling due and being recorded as
# expired. Matched to PRESENCE_SWEEP_INTERVAL_SECONDS: same kind of job, and
# no reason for an operator to hold two numbers.
MATCHMAKING_EXPIRY_INTERVAL_SECONDS=15.0
# How many tickets one sweep may expire. The case it is for is a queue that
# filled while the sweeper was down.
MATCHMAKING_EXPIRY_BATCH_SIZE=200
# How many waiting tickets one queue snapshot reads. The depth reported beside
# them is a count over the same predicate rather than the length of this page,
# so a bounded read never becomes a wrong number.
MATCHMAKING_SNAPSHOT_LIMIT=200

# --- matchmaking, the pairing scan (A64-015.3) ------------------------------
# Whether *this process* scans pools for pairings. It shipped `false` for one
# task, because `game` could not store a match and every pairing found would
# have been reserved, refused and released several times a second forever.
# A64-015.4 gave it a table, a unique `pairing_id`, ticket settlement,
# automatic reconciliation and an acceptance window — the five things that had
# to be true — and it is on by default from there.
#
# Per-process, like OUTBOX_WORKER_ENABLED: one API tier with it off, one worker
# tier with it on, running the same image. Off everywhere stops new pairings
# and leaves the rest of the queue working — players still join, wait, expire.
MATCHMAKING_PAIRING_ENABLED=true
# How often one pool is scanned. A second, against fifteen for the expiry
# sweep, and the asymmetry is the point: an expiry fifteen seconds late is
# invisible against a ten-minute window, while a pairing fifteen seconds late
# is fifteen seconds somebody spends watching a spinner beside an opponent they
# could already be playing.
MATCHMAKING_PAIRING_INTERVAL_SECONDS=1.0
# How many waiting tickets one pass reads from a pool. It reads the *oldest*
# ones, which is where a queue that serves the longest wait first always finds
# its answer, and it is also the width of the block read — so raising it
# lengthens one query's parameter list rather than adding queries.
MATCHMAKING_CANDIDATE_BATCH_SIZE=200
# QT-5's widening rating window. It starts narrow because it widens on its own:
# starting tight costs a few seconds, starting loose costs a bad first game.
# The maximum is reached after about two and a half minutes at these values —
# well inside the ticket window, so a player in a thin pool spends most of
# their wait at the widest setting and then expires honestly rather than being
# handed a hopeless game.
MATCHMAKING_RATING_WINDOW_INITIAL=100
MATCHMAKING_RATING_WINDOW_WIDEN_EVERY_SECONDS=15.0
MATCHMAKING_RATING_WINDOW_WIDEN_BY=50
MATCHMAKING_RATING_WINDOW_MAXIMUM=600

# --- matchmaking, the acceptance handshake (A64-015.4) ----------------------
# **One number for two deadlines.** A pairing worker computes `now + this`
# once, writes it to both reserved tickets as `reserved_until`, and sends the
# same instant to `game` as the match's acceptance deadline — so the window a
# worker is given to finish and the window a player is given to answer are the
# same value in two rows rather than two timers somebody has to keep in step.
#
# Thirty seconds is set against the only thing it is really about: how long the
# opponent stares at a spinner while somebody decides. It must be strictly
# under MATCHMAKING_TICKET_TTL_SECONDS, and the process refuses to start
# otherwise — a reservation that could outlive its own ticket leaves the two
# deadlines racing.
MATCHMAKING_RESERVATION_TTL_SECONDS=30
# Whether *this process* recovers stranded pairings — the job that replaces
# A64-015.3's manual repair. Closer to a correctness switch than a kill switch:
# with it off everywhere a worker that dies mid-pairing leaves two tickets
# reserved until their ordinary ten-minute window closes, and a match that was
# created but not settled stays that way. Nothing is corrupted; recovery simply
# stops being automatic. It exists so an operator investigating an incident can
# stop a job that rewrites rows.
MATCHMAKING_RECONCILIATION_ENABLED=true
# How often stranded pairings are looked for. Both things waiting on it — a
# match nobody answered, and a player standing in a queue that cannot see them
# — are measured against the reservation window above, so this is a fraction of
# it. Cheap: a healthy tick is two indexed reads against partial indexes that
# carry only rows currently in flight.
MATCHMAKING_RECONCILIATION_INTERVAL_SECONDS=5.0
# How many stranded reservations, and how many overdue matches, one pass may
# resolve. The case it is for is a rolling restart, which strands a burst at
# once; a hundred per tick drains that in seconds without one transaction
# holding hundreds of row locks.
MATCHMAKING_RECONCILIATION_BATCH_SIZE=100

# --- rate limiting, matchmaking (A64-014.1, A64-015.4) ----------------------
# One budget shared by joining and leaving, per authenticated user. Nobody
# joins two hundred times; they join and leave two hundred times, so two
# counters would be two numbers neither of which can be exhausted alone. What
# it bounds is pool churn — re-queueing to influence who you are paired with,
# which is a rating-manipulation vector rather than a load problem. Reading
# your own ticket carries no limit: it is what a client polls while waiting.
RATE_LIMIT_MATCHMAKING_QUEUE_USER_LIMIT=30
RATE_LIMIT_MATCHMAKING_QUEUE_WINDOW_SECONDS=300
# A **separate** budget for accepting and declining, and the separation is the
# decision: a player who has spent their queue budget must still be able to
# answer the match the platform has already paired them into. A shared counter
# would mean the queue creating a match and then refusing to let one of its two
# players say yes — a rate limit turning into a stuck game for somebody else.
# Reading your pending match carries no limit, for the same reason reading your
# ticket does not.
RATE_LIMIT_MATCHMAKING_ACCEPTANCE_USER_LIMIT=20
RATE_LIMIT_MATCHMAKING_ACCEPTANCE_WINDOW_SECONDS=300

# --- storage — object storage for avatars (A64-012.2) -----------------------
# `local` is a **development transport**: objects are files on one node's
# disk, so a deployed tier with two replicas would serve nothing from the
# one that did not receive the upload. `LocalStorageProvider` refuses to
# construct outside local/test for exactly that reason, which means a tier
# that forgets to configure a real provider fails at startup rather than
# accepting uploads it is going to lose.
STORAGE_PROVIDER=local
# Relative to the process working directory. Ignored by git — development
# objects are disposable, and a 5 MB test avatar is not a commit.
STORAGE_LOCAL_ROOT=var/storage
# What `StorageProvider.get_public_url` composes object keys onto. In a
# deployed tier this is a bucket host or a CDN, which is precisely the
# substitution that lets a CDN be put in front without a code change. In
# `local` the path component must match where the app mounts StaticFiles —
# it derives the mount from this value, so the two cannot drift.
STORAGE_PUBLIC_BASE_URL=http://localhost:8000/media

# --- tests/contract/ — not read by the application itself -------------------
# tests/contract/conftest.py reads this one variable directly (not through
# app.config.settings — `test` reads no file at all, by design). Points at
# a *separate* database from POSTGRES_DSN above, created automatically by
# docker/postgres/init/01-create-test-database.sql on a fresh
# docker-compose volume, so a test that bypasses the suite's transaction-
# rollback fixture can never corrupt real local dev data.
# CONTRACT_TEST_POSTGRES_DSN=postgresql+asyncpg://arena64:arena64@localhost:5432/arena64_test
#
# The rate-limiting contract suites need a real Redis and **flush the
# database they are given**. Database 15, never 0-4, which is what the five
# roles above point at in `local` — flushing a developer's live match state
# because a test picked the same index only has to happen once.
# CONTRACT_TEST_REDIS_URL=redis://localhost:6379/15
