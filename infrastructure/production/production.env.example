# Production configuration — A64-028.6 §24.
#
#   cp production.env.example production.env   # then fill every value
#   docker compose --env-file production.env up -d
#
# `production.env` is gitignored (`.gitignore` excludes `infrastructure/**/*.env`
# and keeps `*.env.example`). Nothing here holds a real value.
#
# Every variable below is REQUIRED unless marked otherwise. There are no
# localhost fallbacks: `Settings._forbid_local_defaults_outside_local`
# refuses to start a production tier that kept one, which is a visible
# deploy failure rather than a service quietly talking to nothing.

# --- Identity ---------------------------------------------------------------
# The apex the product is served on. The admin console is served on
# `admin.<this>`, and `PUBLIC_APP_URL`, the browser cookie's trusted origin,
# the media base URL and the client's canonical/og:url are all derived from
# it — one name, one place.
ARENA64_DOMAIN=arena64.gg

# Where Let's Encrypt sends expiry warnings. A certificate that expires
# silently is the outage nobody is paged for.
ARENA64_ACME_EMAIL=ops@arena64.gg

# The API image tag to run. Pin a digest or a release tag for a real deploy;
# `latest` is a rollback you cannot describe.
ARENA64_TAG=latest

# --- Secrets ----------------------------------------------------------------
# 64 hex characters each. `openssl rand -hex 32`.
JWT_SECRET_KEY=
EMAIL_VERIFICATION_OTP_SECRET=

# The operator surface's bearer token — `/metrics` and `POST /health/drain`.
# The tier refuses to start without either this or
# OPS_ALLOW_UNAUTHENTICATED=true, which says the scrape network is trusted.
OPS_TOKEN=

POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- Email ------------------------------------------------------------------
# Required, and required to be real: verification and password reset are
# both unusable without it, and `EmailSettings` refuses a placeholder in a
# deployed tier (A64-028.6 §17, closing P3-3).
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@arena64.gg

# --- Optional ---------------------------------------------------------------
# Seconds between backups. Daily by default. The recovery-point objective
# this implies is stated in `docs/05-operations/backup-restore.md` §3.
BACKUP_INTERVAL_SECONDS=86400
